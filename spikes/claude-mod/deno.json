{
  "tasks": {
    "test": "deno test --allow-read --allow-env swamp/extensions",
    "check": "deno check swamp/extensions/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "plugin:test": "claude plugin test plugin",
    "plugin:validate": "claude plugin validate plugin"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "exclude": [
    "swamp/.swamp",
    "swamp/.claude",
    "plugin"
  ],
  "fmt": {
    "exclude": [
      "swamp/models",
      "swamp/vaults",
      "swamp/workflows",
      "swamp/.swamp.yaml"
    ]
  }
}

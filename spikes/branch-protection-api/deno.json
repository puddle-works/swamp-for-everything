{
  "tasks": {
    "serve": "cd swamp && swamp serve --host 127.0.0.1 --port 9797 --auth-mode none --no-schedule",
    "api": "deno run --allow-net=127.0.0.1,opencode.ai,api.typesafe.ai --allow-env=SWAMP_URL,SWAMP_TOKEN,PORT,JEV_URL,PUDDLE_REPO,PUDDLE_REQUESTER --allow-read=api --allow-run=swamp api/main.ts",
    "test": "deno test --allow-read --allow-env --allow-net=127.0.0.1 swamp/extensions api",
    "check": "deno check api/ swamp/extensions/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "exclude": [
    "swamp/.swamp",
    "swamp/.claude"
  ],
  "fmt": {
    "exclude": [
      "swamp/models",
      "swamp/vaults",
      "swamp/workflows",
      "swamp/.swamp.yaml",
      "api/index.html"
    ]
  }
}

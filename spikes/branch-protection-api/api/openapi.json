{
  "openapi": "3.1.0",
  "info": {
    "title": "Branch-protection check",
    "version": "1.0.0",
    "description": "Deterministic check of whether a GitHub repository's default branch is protected (classic branch protection or a repository ruleset). The answer comes from the `branch-protection` swamp workflow; this API is thin glue over swamp serve. `POST /v1/systemone` is the Jev router: TypeSafe's System One (Jev) API, answered by swamp where a check exists and by Jev otherwise (see docs/jev-router.md)."
  },
  "servers": [{ "url": "http://127.0.0.1:8787" }],
  "security": [],
  "paths": {
    "/check": {
      "post": {
        "operationId": "checkBranchProtection",
        "summary": "Check a repository's default branch for protection",
        "description": "Only the default branch is checked. The Content-Type header is not enforced; the body just has to be JSON. The URL is validated inside the swamp model, so a URL it rejects comes back as 502, not 400.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckRequest" },
              "example": { "url": "https://github.com/octocat/Hello-World" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The check ran.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CheckResult" },
                "example": {
                  "protected": false,
                  "repo": "octocat/Hello-World",
                  "branch": "master"
                }
              }
            }
          },
          "400": {
            "description": "Body is not JSON, `url` is missing or empty, or swamp rejected the workflow inputs.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "url is required" }
              }
            }
          },
          "405": {
            "description": "Method other than POST.",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "502": {
            "description": "The workflow failed: the URL was rejected, the repo was not found, GitHub returned an error, or the GitHub token is missing from the vault. Never reported as `protected: false`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "error": "not a github.com URL: https://gitlab.com/o/r",
                  "failedStep": "check"
                }
              }
            }
          },
          "503": {
            "description": "swamp serve is unreachable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "error": "cannot reach swamp serve: connection refused"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "getTestPage",
        "summary": "Small HTML test page",
        "responses": {
          "200": {
            "description": "The test page.",
            "content": { "text/html": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/v1/systemone": {
      "post": {
        "operationId": "systemOne",
        "summary": "Jev-compatible evaluation, answered by swamp where a check exists",
        "description": "Same request and response as Jev's `POST /v1/systemone` (https://docs.typesafe.ai/api.md). A question that matches a registered check exactly (type and instructions, ignoring case and spacing) and whose inputs are in `state` is answered by its swamp workflow with certainty (`noul` 1 or 0). Everything else goes to Jev in one call with the caller's `Authorization` header. If Jev rates a question with no check at least 0.8 likely to be answerable by code, a puddle asking for the check is raised after the reply. When Jev is not called, `model` echoes the request and `usage` is 0/0.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemOneRequest"
              },
              "example": {
                "state": "The repository https://github.com/octocat/Hello-World ...",
                "model": "jev-1.13-free",
                "questions": {
                  "protected": {
                    "type": "noul",
                    "instructions": "Is the default branch of this repository protected?"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One answer per question, under the caller's ids.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemOneResponse"
                },
                "example": {
                  "model": "jev-1.13-free",
                  "answers": {
                    "protected": {
                      "type": "noul",
                      "noul": 1
                    }
                  },
                  "usage": {
                    "input_tokens": 0,
                    "output_tokens": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Body is not JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method other than POST.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The request does not match Jev's schema.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Jev could not be reached or returned an unexpected response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Any error Jev returned (e.g. 401, 429, 529), passed through unchanged, even if some questions were answered locally.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "An http(s) github.com repository URL. A trailing `.git` or `/`, a query string, a fragment and extra path segments (e.g. `/tree/main/src`) are ignored; only `owner/repo` is used. Other hosts (including GitHub Enterprise), SSH URLs (`git@github.com:owner/repo.git`) and URLs without an `owner/repo` path are rejected.",
            "examples": [
              "https://github.com/owner/repo",
              "https://github.com/owner/repo.git",
              "https://github.com/owner/repo/tree/main/src"
            ]
          }
        }
      },
      "CheckResult": {
        "type": "object",
        "required": ["protected", "repo", "branch"],
        "properties": {
          "protected": {
            "type": "boolean",
            "description": "True if the default branch has classic branch protection or is covered by a repository ruleset."
          },
          "repo": { "type": "string", "description": "`owner/repo`." },
          "branch": {
            "type": "string",
            "description": "The default branch that was checked."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "failedStep": {
            "type": "string",
            "description": "Name of the workflow step that failed (502 only)."
          },
          "details": {
            "description": "Validation details from swamp (400 only)."
          }
        }
      },
      "SystemOneRequest": {
        "type": "object",
        "required": [
          "state",
          "model",
          "questions"
        ],
        "properties": {
          "state": {
            "description": "What to evaluate: text, an object or an array."
          },
          "model": {
            "type": "string",
            "examples": [
              "jev-latest",
              "jev-1.13-free"
            ]
          },
          "questions": {
            "type": "object",
            "minProperties": 1,
            "description": "Question id → question. Each has `type` (`noul`, `choice` or `score`), `instructions`, and `criteria` (required for `choice` and `score`).",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "instructions"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "noul",
                    "choice",
                    "score"
                  ]
                },
                "instructions": {},
                "criteria": {}
              }
            }
          }
        }
      },
      "SystemOneResponse": {
        "type": "object",
        "required": [
          "model",
          "answers",
          "usage"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "answers": {
            "type": "object",
            "description": "Question id → answer: `{type: noul, noul}`, or for choice/score Jev's `probabilities` and `confidence` as well.",
            "additionalProperties": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          },
          "usage": {
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your TypeSafe (Jev) API key; passed through to Jev, not checked by the router."
      }
    }
  }
}

{
  "tasks": {
    "serve": "cd protection && swamp serve --host 127.0.0.1 --port 9797 --auth-mode none --no-schedule",
    "api": "deno run --allow-net=127.0.0.1 --allow-env=SWAMP_URL,SWAMP_TOKEN,PORT api/main.ts",
    "web": "cd web && deno task dev",
    "test": "deno test --allow-read --allow-env --allow-net=127.0.0.1 protection/extensions api web/src",
    "check": "deno check api/ protection/extensions/ && cd web && deno check src/main.tsx src/present_test.ts vite.config.ts",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "exclude": [
    "protection/.swamp",
    "protection/.claude",
    "web/node_modules",
    "web/dist"
  ],
  "fmt": {
    "exclude": [
      "protection/models",
      "protection/workflows",
      "protection/.swamp.yaml"
    ]
  }
}
